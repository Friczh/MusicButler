# Required
DISCORD_TOKEN=
YOUTUBE_COOKIES_BASE64=

# Optional — sidecar location (defaults match start.sh / Dockerfile; only
# override if you're running the bot outside this project's Docker setup)
# POT_PROVIDER_URL=http://127.0.0.1:4416
# POT_SERVER_HOST=127.0.0.1
# POT_SERVER_PORT=4416

# Optional — buffering tuning (see README.md "Buffer" section for what each
# one does; defaults are sane, only set these if you're diagnosing a
# specific stutter/latency issue)
# MB_PREBUFFER_SECONDS=1.5
# MB_NETWORK_BUFFER_MS=2000
# MB_PREBUFFER_TIMEOUT_MS=8000
# MB_ASSUMED_BITRATE_BPS=128000
# MB_STALL_BUFFER_MS=400

# Optional — playlist size cap (see README.md "Playlists" section)
# MB_PLAYLIST_MAX_TRACKS=500

# Optional — auto-exit after this many minutes of being alone in the VC,
# or of nothing playing (paused/queue drained). Two independent timers
# sharing this one duration; whichever fires first disconnects. Set to 0
# to disable both. Default 5.
# MB_IDLE_TIMEOUT_MIN=5

# Optional — timeout (ms) for /play's metadata-resolve step (session
# bootstrap + getInfo/search/playlist fetch). Not the audio pipeline
# itself — see MB_PREBUFFER_TIMEOUT_MS above for that. Default 15000.
# MB_RESOLVE_TIMEOUT_MS=15000

# Optional — verbose debug logging: Discord gateway/voice connection state,
# streaming source/track lifecycle, periodic buffer-state snapshots.
# Off by default (any value other than the literal string "true" is off).
# MB_VERBOSE=true

# Optional — health check HTTP server (only needed on Render, which requires
# binding $PORT for its liveness check; pointless on a plain host like the
# friend's laptop deployment). Off by default. Render's own env config
# should set this to true; PORT is set automatically by Render when it does.
# MB_HEALTH_ENABLED=true
# PORT=8080
